# ── AURELIUS environment ────────────────────────────────────────────────
# Copy to .env.local for local development, or set in your host's dashboard.

# Seed password for demo accounts (buyer@ / seller@ / authenticator@ / admin@ aurelius.local)
# CHANGE THIS on any public deployment.
AURELIUS_SEED_PASSWORD=Aurelius#Demo2024

# Payment driver: mock (default — no credentials needed). Stripe is architecture-ready, not implemented.
PAYMENT_DRIVER=mock

# Session lifetime in minutes (default 7 days)
SESSION_TTL_MINUTES=10080

# Password-reset token lifetime in minutes (default 30)
RESET_TOKEN_TTL_MINUTES=30

# Offer expiry in days (default 7)
OFFER_EXPIRY_DAYS=7

# Platform fee in basis points (default 500 = 5%)
PLATFORM_FEE_BASIS_POINTS=500

# Upload limits (default 5 MB)
UPLOAD_MAX_BYTES=5242880

# Data directories (defaults shown; only override for exotic setups)
# AURELIUS_DATA_DIR=data/local
# AURELIUS_STORAGE_DIR=storage/local
